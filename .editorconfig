# SPDX-License-Identifier: MPL-2.0
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{dart,yaml,yml,json,jsonc,arb,md,js,mjs,ts,tsx,css,html,xml,nix}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.go,go.mod,go.sum,Makefile,*.mk}]
indent_style = tab

[justfile]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
