# Normalize line endings; Windows scripts keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git LFS: binary design assets only. Text under design/ (tokens *.json,
# icons *.svg, docs, recipes) stays in regular git for diffs and CI tools.
design/**/*.png filter=lfs diff=lfs merge=lfs -text
design/**/*.jpg filter=lfs diff=lfs merge=lfs -text
design/**/*.webp filter=lfs diff=lfs merge=lfs -text
design/**/*.avif filter=lfs diff=lfs merge=lfs -text
design/**/*.psd filter=lfs diff=lfs merge=lfs -text
design/**/*.kra filter=lfs diff=lfs merge=lfs -text
design/**/*.blend filter=lfs diff=lfs merge=lfs -text
design/**/*.icon filter=lfs diff=lfs merge=lfs -text
design/**/*.riv filter=lfs diff=lfs merge=lfs -text
design/**/*.lottie filter=lfs diff=lfs merge=lfs -text
design/**/*.penpot filter=lfs diff=lfs merge=lfs -text
design/**/*.fig filter=lfs diff=lfs merge=lfs -text

# Generated brand exports stay in plain git (DSN-006): small (< 0.7 MiB total),
# byte-reproducible by `just design brand`, checked by CI and consumed by app
# builds without `git lfs pull`. Masters are SVG anyway.
design/brand/export/** -filter -diff -merge binary
design/brand/preview.png -filter -diff -merge binary
design/placeholders/export/** -filter -diff -merge binary
design/brand/export/**/*.svg -binary text diff
design/brand/export/**/*.xml -binary text diff
design/brand/export/**/*.desktop -binary text diff
design/**/*.ttf filter=lfs diff=lfs merge=lfs -text
design/**/*.otf filter=lfs diff=lfs merge=lfs -text
design/**/*.woff2 filter=lfs diff=lfs merge=lfs -text

# Git LFS: test media (everything except docs and placeholders).
tests/media/** filter=lfs diff=lfs merge=lfs -text
tests/media/**/*.md !filter !diff !merge text
tests/media/**/.gitkeep !filter !diff !merge text

# Generated/lock files: no textual diff noise in reviews.
Cargo.lock linguist-generated=true
