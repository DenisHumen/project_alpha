{
  "name": "@project-alpha/design",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "description": "Design tokens, icon and font pipeline for project_alpha (DSN-002, DSN-004, DSN-005).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:report": "node scripts/validate-tokens.mjs --report",
    "tokens:dart": "node scripts/tokens-dart.mjs",
    "tokens:check": "node scripts/tokens-dart.mjs --check",
    "icons:import": "node scripts/icons-import.mjs",
    "icons:lint": "node scripts/icons-lint.mjs",
    "icons:build": "node scripts/icons-build.mjs",
    "icons:check": "node scripts/icons-build.mjs --check",
    "fonts:fetch": "node scripts/fonts-fetch.mjs",
    "fonts:specimen": "node scripts/fonts-specimen.mjs",
    "check": "npm run tokens:validate && npm run tokens:check && npm run icons:lint && npm run icons:check",
    "test": "node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "lucide-static": "1.72.0",
    "opentype.js": "2.0.0",
    "svgo": "4.1.0"
  }
}
