{
  "$description": "Density profile 'desktop' (DSN-002): Desktop (Windows, Linux, macOS windows ≥ 1024 pt). Mouse + keyboard: hover replaces focus scale. Overrides scale-dependent roles only, never colours. Every density file defines the same set of tokens.",
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 40, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": -0.5, "unit": "px" },
        "lineHeight": 1.2
      },
      "$description": "40/48"
    },
    "title1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 28, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": -0.25, "unit": "px" },
        "lineHeight": 1.214
      },
      "$description": "28/34"
    },
    "title2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 22, "unit": "px" },
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.273
      },
      "$description": "22/28"
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 15, "unit": "px" },
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.333
      },
      "$description": "15/20"
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 15, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.333
      },
      "$description": "15/20"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.385
      },
      "$description": "13/18"
    },
    "callout": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.385
      },
      "$description": "13/18"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 11, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.273
      },
      "$description": "11/14"
    },
    "caption2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 10, "unit": "px" },
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.3
      },
      "$description": "10/13",
      "$extensions": {
        "org.project-alpha": { "fontFeatures": ["tnum"] }
      }
    },
    "timecode": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 11, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.273
      },
      "$description": "11/14, tabular figures (font-feature tnum) — timecodes, bitrates.",
      "$extensions": {
        "org.project-alpha": { "fontFeatures": ["tnum"] }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "margin": { "$value": { "value": 32, "unit": "px" }, "$description": "Horizontal screen margin." },
    "safe-top": {
      "$value": { "value": 0, "unit": "px" },
      "$description": "Overscan-safe inset (TV: 60 pt top/bottom, 80 pt sides per HIG); 0 = use the OS safe area."
    },
    "safe-bottom": { "$value": { "value": 0, "unit": "px" }, "$description": "See safe-top." },
    "safe-side": { "$value": { "value": 0, "unit": "px" }, "$description": "See safe-top." },
    "gutter": {
      "$value": { "value": 24, "unit": "px" },
      "$description": "Gap between items in a row/grid (TV 40 pt per HIG)."
    },
    "row-gap": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "Vertical gap between shelves (TV ≥ 100 pt between rows without titles)."
    },
    "section-gap": { "$value": { "value": 32, "unit": "px" }, "$description": "Gap between sections with titles." },
    "poster-width": {
      "$value": { "value": 160, "unit": "px" },
      "$description": "Unfocused poster width (TV: 6 columns = 260 pt); on other densities the MIN width for computed columns."
    },
    "card-width": {
      "$value": { "value": 320, "unit": "px" },
      "$description": "Unfocused 16:9 card width (TV: 4 columns = 410 pt); MIN width elsewhere."
    },
    "columns": {
      "$type": "number",
      "$description": "Fixed column counts; 0 = computed from the min width (poster-width / card-width) and the window width.",
      "poster": { "$value": 0 },
      "card": { "$value": 0 }
    }
  },
  "shape": {
    "$type": "dimension",
    "card": { "$value": "{radius.md}", "$description": "Cards and posters (12 pt, TV 16 pt; 01 §4.3)." },
    "panel": { "$value": "{radius.xl}", "$description": "Panels and dialogs (24–32 pt, concentric)." },
    "control": { "$value": "{radius.full}", "$description": "Buttons are capsules." }
  },
  "icon-size": {
    "$type": "dimension",
    "sm": { "$value": { "value": 16, "unit": "px" } },
    "md": { "$value": { "value": 20, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "control": {
    "$type": "dimension",
    "height-sm": { "$value": { "value": 24, "unit": "px" } },
    "height-md": { "$value": { "value": 32, "unit": "px" } },
    "height-lg": { "$value": { "value": 44, "unit": "px" } }
  }
}
