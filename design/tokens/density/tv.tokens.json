      "$extensions": {
        "org.project-alpha": { "fontFeatures": ["tnum"] }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "margin": { "$value": { "value": 80, "unit": "px" }, "$description": "Horizontal screen margin." },
    "safe-top": {
      "$value": { "value": 60, "unit": "px" },
      "$description": "Overscan-safe inset (TV: 60 pt top/bottom, 80 pt sides per HIG); 0 = use the OS safe area."
    },
    "safe-bottom": { "$value": { "value": 60, "unit": "px" }, "$description": "See safe-top." },
    "safe-side": { "$value": { "value": 80, "unit": "px" }, "$description": "See safe-top." },
    "gutter": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "Gap between items in a row/grid (TV 40 pt per HIG)."
    },
    "row-gap": {
      "$value": { "value": 100, "unit": "px" },
      "$description": "Vertical gap between shelves (TV ≥ 100 pt between rows without titles)."
    },
    "section-gap": { "$value": { "value": 64, "unit": "px" }, "$description": "Gap between sections with titles." },
    "poster-width": {
      "$value": { "value": 260, "unit": "px" },
      "$description": "Unfocused poster width (TV: 6 columns = 260 pt); on other densities the MIN width for computed columns."
    },
    "card-width": {
      "$value": { "value": 410, "unit": "px" },
      "$description": "Unfocused 16:9 card width (TV: 4 columns = 410 pt); MIN width elsewhere."
    },
    "columns": {
      "$type": "number",
      "$description": "Fixed column counts; 0 = computed from the min width (poster-width / card-width) and the window width.",
      "poster": { "$value": 6 },
      "card": { "$value": 4 }
    }
  },
  "shape": {
    "$type": "dimension",
    "card": { "$value": "{radius.lg}", "$description": "Cards and posters (12 pt, TV 16 pt; 01 §4.3)." },
    "panel": { "$value": "{radius.2xl}", "$description": "Panels and dialogs (24–32 pt, concentric)." },
    "control": { "$value": "{radius.full}", "$description": "Buttons are capsules." }
  },
  "icon-size": {
    "$type": "dimension",
    "sm": { "$value": { "value": 28, "unit": "px" } },
    "md": { "$value": { "value": 36, "unit": "px" } },
    "lg": { "$value": { "value": 48, "unit": "px" } }
  },
  "control": {
    "$type": "dimension",
    "height-sm": { "$value": { "value": 56, "unit": "px" } },
    "height-md": { "$value": { "value": 66, "unit": "px" } },
    "height-lg": { "$value": { "value": 86, "unit": "px" } }
  }
}
