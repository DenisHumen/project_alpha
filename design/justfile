# `design` module: design tokens and assets (DSN workstream, docs/ROADMAP.md §0.4).
# Requires Node ≥ 20. First run: `just design setup`.

# List recipes
default:
    @just --list design

# Install pinned tooling (svgo, lucide-static) into design/node_modules
setup:
    npm ci --ignore-scripts

# Everything CI checks: tokens (DTCG, refs, contrast), icons lint, generated code fresh, unit tests
check:
    npm run check
    npm test

# Regenerate all derived files (token code, icon code/catalog, brand assets, type specimen)
build: tokens icons brand
    npm run fonts:specimen

# Token code (DSN-003): Dart (pa_design), Swift (Apple), Kotlin (Android), CSS (web) from tokens/*.tokens.json
tokens:
    npm run tokens:validate
    npm run tokens:build

# Print the WCAG contrast table for all text/background pairs
contrast:
    npm run tokens:report

# Re-import curated icons from Lucide (after editing icons/manifest.json), lint, generate code
icons:
    npm run icons:import
    npm run icons:lint
    npm run icons:build

# Download Inter (SHA-256 pinned) into fonts/files and flutter/pa_design/fonts
fonts *args:
    node scripts/fonts-fetch.mjs {{args}}

# Brand assets (DSN-006): app icons, TV banner, favicon, lockups, placeholder PNGs from SVG masters
brand:
    npm run brand:build

# Re-outline the wordmark from Inter Display SemiBold (only when the wordmark changes)
brand-wordmark font:
    node scripts/brand-wordmark.mjs --font {{font}}
