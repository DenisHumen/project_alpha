{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisHumen/project_alpha/tools/recognition-eval/schema/corpus-record.v1.schema.json",
  "title": "project_alpha recognition corpus record (one JSONL line = one case)",
  "description": "A case is a directory tree (one or more files) with ground-truth labels. Structural rules live here; cross-field rules (coverage, references, numbering consistency) are enforced by corpus-validate. See GUIDE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "categories", "split", "source", "input", "labels", "review"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "Stable case id, never reused.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "categories": {
      "description": "Taxonomy codes (taxonomy.v1.json). The first one is the primary category used for stratification.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][0-9]{1,3}$" }
    },
    "split": { "enum": ["train", "dev", "test", "example"] },
    "source": { "$ref": "#/$defs/source" },
    "input": { "$ref": "#/$defs/input" },
    "labels": { "$ref": "#/$defs/labels" },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "relPath": {
      "description": "Relative POSIX path inside the case. No leading or trailing slash, no backslash; '.'/'..'/empty segments are rejected by corpus-validate.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\][^\\\\]*[^/\\\\]$|^[^/\\\\]$"
    },
    "lang": {
      "description": "ISO 639-2/B three-letter code, 'und' if unknown.",
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license"],
      "properties": {
        "kind": {
          "enum": ["synthetic", "release_feed", "volunteer_library", "eval_suite", "issue_report", "manual"]
        },
        "license": {
          "description": "SPDX id of the record content (e.g. MPL-2.0, CC0-1.0, LGPL-3.0-only). Records under GPL/LGPL never leave the eval repository.",
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "description": "Where the names came from (feed name, suite file, volunteer pseudonym). No personal data.",
          "type": "string"
        },
        "note": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileEntry" }
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "size": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "container": { "type": "string" },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "codec": { "type": "string" },
            "hdr": { "enum": ["sdr", "hdr10", "hdr10plus", "hlg", "dolby_vision"] }
          }
        },
        "audio_langs": { "type": "array", "items": { "$ref": "#/$defs/lang" } },
        "sub_langs": { "type": "array", "items": { "$ref": "#/$defs/lang" } },
        "oshash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "ed2k": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "crc32": {
          "description": "CRC32 actually computed over the file (not the one written in the name).",
          "type": "string",
          "pattern": "^[0-9A-F]{8}$"
        },
        "embedded_tags": {
          "description": "Container tags as reported by ffprobe (MKV title, SEASON, EPISODE, IMDB, TMDB, MP4 tvsh/tves...).",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["works", "files"],
      "properties": {
        "works": {
          "type": "array",
          "items": { "$ref": "#/$defs/work" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileLabel" }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "title", "ids"],
      "properties": {
        "ref": { "type": "string", "pattern": "^w[0-9]{1,3}$" },
        "kind": { "enum": ["movie", "show", "anime"] },
        "anime_type": { "enum": ["tv", "ova", "ona", "movie", "special", "music_video"] },
        "title": {
          "description": "Human-readable title for reviewers (not used for scoring).",
          "type": "string",
          "minLength": 1
        },
        "year": { "type": "integer", "minimum": 1870, "maximum": 2100 },
        "ids": { "$ref": "#/$defs/ids" },
        "display_scheme": { "$ref": "#/$defs/scheme" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "anime" } } },
          "then": { "required": ["anime_type"] },
          "else": { "not": { "required": ["anime_type"] } }
        }
      ]
    },
    "ids": {
      "description": "External ids. tmdb/tvdb carry the entity type as a prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmdb": { "type": "string", "pattern": "^(movie|tv|collection):[1-9][0-9]*$" },
        "tvdb": { "type": "string", "pattern": "^(series|movie):[1-9][0-9]*$" },
        "imdb": { "type": "string", "pattern": "^tt[0-9]{7,9}$" },
        "anidb": { "type": "integer", "minimum": 1 },
        "anilist": { "type": "integer", "minimum": 1 },
        "mal": { "type": "integer", "minimum": 1 },
        "kitsu": { "type": "integer", "minimum": 1 },
        "shikimori": { "type": "integer", "minimum": 1 },
        "kinopoisk": { "type": "integer", "minimum": 1 },
        "tvmaze": { "type": "integer", "minimum": 1 }
      }
    },
    "scheme": {
      "enum": ["tmdb", "tvdb_aired", "tvdb_dvd", "tvdb_absolute", "anidb", "tmdb_group"]
    },
    "seasonEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "episode"],
      "properties": {
        "season": { "type": "integer", "minimum": 0 },
        "episode": { "type": "integer", "minimum": 0 }
      }
    },
    "fileLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "unit": {
          "description": "file (default) or a disc directory that covers every input file below it.",
          "enum": ["file", "bdmv", "video_ts"]
        },
        "role": { "enum": ["main", "part", "extra", "sample", "sidecar", "ignore", "unknown"] },
        "work": { "type": "string", "pattern": "^w[0-9]{1,3}$" },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/episode" }
        },
        "part": { "type": "integer", "minimum": 1 },
        "extra_type": {
          "enum": [
            "trailer", "teaser", "featurette", "behind_the_scenes", "deleted_scene", "interview",
            "short", "scene", "opening", "ending", "menu", "preview", "other"
          ]
        },
        "edition": {
          "enum": [
            "theatrical", "directors_cut", "extended", "unrated", "uncut", "remastered",
            "imax", "special_edition", "final_cut", "other"
          ]
        },
        "parse": { "$ref": "#/$defs/parseTarget" },
        "notes": { "type": "string" }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["numbering"] }, { "required": ["air_date"] }],
      "properties": {
        "type": { "enum": ["regular", "special", "credit", "trailer", "parody", "other", "recap"] },
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tmdb": { "$ref": "#/$defs/seasonEpisode" },
            "tvdb_aired": { "$ref": "#/$defs/seasonEpisode" },
            "tvdb_dvd": { "$ref": "#/$defs/seasonEpisode" },
            "tvdb_absolute": { "type": "integer", "minimum": 1 },
            "anidb": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "number"],
              "properties": {
                "type": { "enum": ["regular", "special", "credit", "trailer", "parody", "other"] },
                "number": { "type": "integer", "minimum": 1 }
              }
            },
            "tmdb_group": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group_id", "season", "episode"],
              "properties": {
                "group_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
                "season": { "type": "integer", "minimum": 0 },
                "episode": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "air_date": { "type": "string", "format": "date" },
        "title": { "type": "string" }
      }
    },
    "parseTarget": {
      "description": "Expected filename-level parse (parser metrics). Values as written by the releaser, not provider numbering.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "alt_titles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "year": { "type": "integer", "minimum": 1870, "maximum": 2100 },
        "season": { "type": "integer", "minimum": 0 },
        "episodes": {
          "description": "Episode numbers as written; fractional values allowed (18.5).",
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "absolute": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "episode_kind": { "enum": ["regular", "special", "ova", "ona", "recap", "ncop", "nced", "sp"] },
        "date": { "type": "string", "format": "date" },
        "part": { "type": "integer", "minimum": 1 },
        "release_group": { "type": "string", "minLength": 1 },
        "dub_studio": { "type": "string", "minLength": 1 },
        "crc32": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
        "version": { "type": "integer", "minimum": 1 },
        "resolution": { "type": "string" },
        "source": { "type": "string" },
        "edition": { "type": "string" },
        "languages": { "type": "array", "items": { "$ref": "#/$defs/lang" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "annotators"],
      "properties": {
        "status": { "enum": ["draft", "verified", "disputed"] },
        "annotators": {
          "description": "Pseudonyms only, never real names or emails.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$" }
        },
        "double_labelled": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
