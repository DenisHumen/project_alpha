From: project_alpha contributors
Subject: [PATCH] meson: probe DXGI_DEBUG_D3D11 on every win32 build

d3d11_helpers.h defines DXGI_DEBUG_D3D11 unless meson found it, but the
probe only ran with d3d11 output or ANGLE, not for vf_d3d11vpp
(d3d-hwaccel). mingw-w64 12 declares the GUID, so that build failed
with a redefinition. Not sent upstream yet.

--- a/meson.build
+++ b/meson.build
@@ -1388,8 +1388,11 @@
 
 if features['d3d11'] or features['egl-angle-win32'] or (features['vulkan'] and win32)
     sources += files('video/out/gpu/d3d11_helpers.c')
-    features += {'dxgi-debug-d3d11': cc.has_header_symbol('d3d11sdklayers.h', 'DXGI_DEBUG_D3D11')}
 endif
+# d3d11_helpers.h is also included by vf_d3d11vpp.c (d3d-hwaccel), so probe on
+# every win32 build; mingw-w64 >= 12 declares the GUID in d3d11sdklayers.h.
+features += {'dxgi-debug-d3d11': win32 and cc.has_header_symbol('d3d11sdklayers.h', 'DXGI_DEBUG_D3D11',
+                                                                prefix: '#include <windows.h>')}
 
 # hwaccel
 ffnvcodec = dependency('ffnvcodec', version: '>= 11.1.5.1', required: false)
