#
# Pins that mise.toml cannot express (REPO-008). Plain KEY=value lines: sourced
# by bootstrap.sh and the Dev Container Dockerfile, parsed by bootstrap.ps1.

# mise itself (https://github.com/jdx/mise/releases)
MISE_VERSION=2026.11.8
MISE_SHA256_LINUX_X64=d2d5a46f507bba772686e2c8f2316b3a4439dac49a37a30db5c0e7bb077c5431
MISE_SHA256_LINUX_ARM64=b36da3c4892380325d44dee3678ba618de191254d8a4aed8011ee66b28a6cbd7

# Android SDK command-line tools (repository2-3.xml, cmdline-tools;latest)
ANDROID_CMDLINE_TOOLS_BUILD=16111833
ANDROID_CMDLINE_TOOLS_SHA256_LINUX=0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8

# Android SDK packages installed by `sdkmanager` (same as PLAY-AND-001 spike)
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_NDK=28.2.13676358

# Minimum versions of tools that come from the OS
MIN_PYTHON=3.10
MIN_GIT=2.40
