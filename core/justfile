# `core` module: Rust core: core/crates/pa-*.
# Owned by the CORE workstream (docs/ROADMAP.md §0.4).

set working-directory := '..'

# Output of `just core bindings`. Generated code is never committed (ADR-0001).
bindings_dir := 'target/bindings'

lib_file := if os() == 'macos' { 'libpa_ffi.dylib' } else if os() == 'windows' { 'pa_ffi.dll' } else { 'libpa_ffi.so' }

smoke_dir := 'target/ffi-smoke'

# Run the pa-ffi tests (Rust side of the FFI boundary)
test-ffi:
    cargo test -p pa-ffi

# Generate Kotlin and Swift bindings for pa-ffi into target/bindings/{kotlin,swift}
bindings: (bindings-for 'kotlin') (bindings-for 'swift')

# Generate bindings for one language (kotlin | swift) from the host cdylib
bindings-for language:
    cargo build -p pa-ffi --lib
    rm -rf {{ bindings_dir }}/{{ language }}
    cargo run -q -p pa-ffi --features cli --bin uniffi-bindgen -- \
        generate --library target/debug/{{ lib_file }} --no-format \
        --language {{ language }} --out-dir {{ bindings_dir }}/{{ language }}
    @echo "{{ language }} bindings: {{ bindings_dir }}/{{ language }}"

# Call core_version() from Kotlin on the JVM via JNA (needs JDK 21 and `gradle` on PATH)
smoke-jvm: (bindings-for 'kotlin')
    cd core/crates/pa-ffi/jvm-smoke && gradle test --console=plain

# Call core_version() from Swift on the host (needs `swiftc`; Linux or macOS)
smoke-swift: (bindings-for 'swift')
    mkdir -p {{ smoke_dir }}
    swiftc -module-name PACore \
        -Xcc -fmodule-map-file={{ bindings_dir }}/swift/PACoreFFI.modulemap -I {{ bindings_dir }}/swift \
        {{ bindings_dir }}/swift/PACore.swift core/crates/pa-ffi/swift-smoke/main.swift \
        -L target/debug -lpa_ffi -o {{ smoke_dir }}/swift-smoke
    LD_LIBRARY_PATH=target/debug DYLD_LIBRARY_PATH=target/debug {{ smoke_dir }}/swift-smoke

# Apple (macOS + Xcode): PACoreFFI.xcframework + Swift wrapper for tools/bindings/PACore (CORE-003)
xcframework *args:
    tools/bindings/build-xcframework.sh {{ args }}

# Apple: PACore XCTest calls core_version() (platform: macos | ios | tvos)
test-pacore platform='macos':
    tools/bindings/test-pacore.sh {{ platform }}

# Android: AAR pa-core-android (cargo-ndk jniLibs + UniFFI Kotlin) into target/android (CORE-004)
aar *args:
    tools/bindings/build-aar.sh {{ args }}

# Android: check the AAR contents (ABIs, ELF machine, 16 KB alignment, Kotlin API); no device needed
check-aar *args:
    tools/bindings/check-aar.sh {{ args }}

# Android: instrumented tests of pa-core-android on a running emulator or device
test-aar:
    tools/bindings/test-aar.sh

# flutter_rust_bridge version; keep equal to Cargo.toml and pa_core/pubspec.yaml
frb_version := '2.13.0'

pa_core_dir := 'clients/flutter/packages/pa_core'

# Regenerate the Dart bindings of pa-frb (pa_core/lib/src/rust, pa-frb/src/frb_generated.rs)
frb:
    cd {{ pa_core_dir }} && dart pub get && flutter_rust_bridge_codegen generate

# Fail if the committed FRB bindings differ from a fresh `just core frb`
frb-check: frb
    git diff --exit-code -- {{ pa_core_dir }}/lib/src/rust core/crates/pa-frb/src/frb_generated.rs

# Install flutter_rust_bridge_codegen of the pinned version
frb-install:
    cargo install flutter_rust_bridge_codegen --version {{ frb_version }} --locked

# Dart tests of pa_core: the Native Assets hook builds pa-frb, tests call into Rust
test-pa-core:
    cd {{ pa_core_dir }} && dart pub get && dart test

# Remote config (CORE-014, docs/dev/remote-config.md). Owner only, offline:
# sign every config/*.json with the minisign secret key `key`
# (default: $KINOLUNE_CONFIG_KEY), then check them like the app does.
sign-config key=env('KINOLUNE_CONFIG_KEY', ''):
    #!/usr/bin/env bash
    set -euo pipefail
    key='{{ key }}'
    if [ -z "$key" ]; then echo "set KINOLUNE_CONFIG_KEY or pass key=<path to the minisign secret key>" >&2; exit 1; fi
    shopt -s globstar nullglob
    for f in config/**/*.json; do
        # Default trusted comment carries `file:<name>`; the app requires it.
        minisign -S -s "$key" -m "$f"
    done
    just core remote-config-verify

# Verify config/**/*.json against their .minisig (production key, or pubkey=<minisign.pub>)
remote-config-verify pubkey='':
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s globstar nullglob
    files=(config/**/*.json)
    args=()
    if [ -n '{{ pubkey }}' ]; then args=(--pubkey '{{ pubkey }}'); fi
    cargo run -q -p pa-remote-config --example check -- "${args[@]}" "${files[@]}"

# Fail while the production minisign key is a placeholder (for release workflows)
remote-config-release-check:
    cargo run -q -p pa-remote-config --example check -- --release
