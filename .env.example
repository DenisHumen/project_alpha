# SPDX-License-Identifier: MPL-2.0
#
# Шаблон локальных переменных окружения для разработки.
# Скопируйте в `.env.local` (он в .gitignore) и заполните своими значениями:
#   cp .env.example .env.local
# Реальные ключи и токены в git не коммитятся: это ловит gitleaks
# (pre-commit и CI). Какие секреты где живут — docs/dev/secrets.md.
#
# Все переменные необязательны: без ключа соответствующий провайдер
# просто выключен в dev-сборке, а пользователь может ввести свой ключ в UI.
# Значения-заглушки вида `changeme` gitleaks не считает секретами.

# --- Общие ---------------------------------------------------------------

# Уровень логирования Rust (tracing / env_logger)
RUST_LOG=info

# --- Ключи провайдеров для локальной разработки (секретные) --------------
# В релизных сборках подставляются из GitHub Secrets окружений `release`
# и `store`. Для разработки заведите свой личный ключ у провайдера.
# Условия провайдеров: docs/legal/providers.md.

# TMDB API Read Access Token (v4) или API key (v3)
PA_TMDB_API_KEY=changeme
# Fanart.tv project API key
PA_FANART_API_KEY=changeme
# OpenSubtitles.com API key (ключ приложения; логин — у пользователя)
PA_OPENSUBTITLES_API_KEY=changeme
# AcoustID application key (только opt-in отпечатки)
PA_ACOUSTID_APP_KEY=changeme

# --- Публичные идентификаторы клиентов (не секрет, но держим здесь) -----
# Twitch: только public client + Device Code Flow, client secret не нужен
# и запрещён. Trakt: device code / PKCE, без secret. LRCLIB: App-Id.
# AniDB: зарегистрированное имя клиента и его версия (целое).
PA_TWITCH_CLIENT_ID=changeme
PA_TRAKT_CLIENT_ID=changeme
PA_LRCLIB_APP_ID=changeme
PA_ANIDB_CLIENT=changeme
PA_ANIDB_CLIENTVER=1

# --- Сборка (не секреты) -------------------------------------------------
# Переменные скриптов сборки FFmpeg (tools/ffmpeg/README.md), например:
# PA_FF_JOBS=4
