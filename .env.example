#
# Шаблон локальных переменных окружения для разработки.
# Скопируйте в `.env.local` (он в .gitignore) и заполните своими значениями.
# Реальные ключи и токены в git не коммитятся. Полный список переменных
# и где живут секреты — задача REPO-009.

# Уровень логирования Rust (tracing / env_logger)
RUST_LOG=info
