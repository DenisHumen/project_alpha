"""Placeholder for project_alpha services in the phase-0 NAS OS image.

Serves GET /health and /healthz with a small JSON document so that
greenboot checks and VM tests can probe the service before the real
binaries (media server, alpha-admin, alpha-updated) exist.

Usage: alpha-stub <service-name> <port>
"""

import json
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


class DualStackServer(ThreadingHTTPServer):
    """Listens on IPv6 and IPv4 when IPv6 is available, IPv4 only otherwise."""

    address_family = socket.AF_INET6 if socket.has_ipv6 else socket.AF_INET

    def server_bind(self) -> None:
        if self.address_family == socket.AF_INET6:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


def read_version() -> str:
    try:
        with open("/usr/share/alpha/version", encoding="utf-8") as fh:
            for line in fh:
                key, _, value = line.strip().partition("=")
                if key == "ALPHA_OS_VERSION":
                    return value
    except OSError:
        pass
    return "unknown"


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: alpha-stub <service-name> <port>", file=sys.stderr)
        return 2
    name, port = sys.argv[1], int(sys.argv[2])
    body = json.dumps(
        {"service": name, "status": "ok", "stub": True, "os_version": read_version()}
    ).encode()

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # noqa: N802 (http.server API)
            if self.path in ("/health", "/healthz"):
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.send_error(404)

        def log_message(self, fmt: str, *args: object) -> None:
            pass

    host = "::" if DualStackServer.address_family == socket.AF_INET6 else "0.0.0.0"
    server = DualStackServer((host, port), Handler)
    print(f"{name} stub listening on port {port}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
