# Phase-0 placeholder (DIST-001): replaced by the real alpha-admin (DIST-013) later.
[Unit]
Description=project_alpha admin backend (stub)
Documentation=https://github.com/DenisHumen/project_alpha/tree/main/distro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/libexec/alpha/alpha-stub alpha-admin 80
DynamicUser=yes
StateDirectory=alpha-admin
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
