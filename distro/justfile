# `distro` module: NAS OS.
# Owned by the DIST workstream (docs/ROADMAP.md §0.4); its tasks replace this placeholder.

# List disks the installer would offer (read-only; --all shows excluded ones)
installer-disks *args:
    cd installer && go run ./cmd/alpha-installer disks {{args}}

# Installer Go checks: gofmt, vet, tests on recorded lsblk/udev fixtures
installer-test:
    cd installer && test -z "$(gofmt -l .)" && go vet ./... && go test ./...
